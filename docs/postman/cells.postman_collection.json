    {
      "name": "Devices (phone push)",
      "item": [
        {
          "name": "Register phone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            },
            "description": "The mobile app calls this after login with its Firebase (FCM) registration token. Repeating it is harmless; a token last used by another account moves to this one. Returns 204. Any logged-in role.\n\ncURL:\n\n```\ncurl -X POST \"{{baseUrl}}/devices\" \\\n  -H \"Accept: application/json\" \\\n  -H \"Authorization: Bearer {{accessToken}}\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n  \"token\": \"{{pushToken}}\",\n  \"platform\": \"ANDROID\"\n}'\n```",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{pushToken}}\",\n  \"platform\": \"ANDROID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Unregister phone",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/{{pushToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "{{pushToken}}"
              ]
            },
            "description": "Call at logout. Removes only the logged-in user's own registration of that token. Returns 204 even if nothing was there.\n\ncURL:\n\n```\ncurl -X DELETE \"{{baseUrl}}/devices/{{pushToken}}\" \\\n  -H \"Accept: application/json\" \\\n  -H \"Authorization: Bearer {{accessToken}}\"\n```",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
